{
  "name": "dsh-learning-desk",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Personal learning desk for the DeepSeek Harness Web GUI: timetable, day plan, focus timer, notes, review cards, and stats in one sidebar panel.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "learning",
    "timetable",
    "spaced-repetition"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check client.js && node scripts/validate-manifest.mjs && node scripts/validate-ui.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2723191422-lab/-DeepSeek-Harness-.git"
  }
}
